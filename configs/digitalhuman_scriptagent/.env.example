# DigitalHuman ScriptAgent adapter env (CineWorldSim style)

# Root paths
DIGITALHUMAN_ROOT=/data1/AgentG/hhb/digitalhuman
SCRIPTAGENT_ROOT=/data1/AgentG/hhb/digitalhuman/ScriptAgent
SCRIPTAGENT_CODE_DIR=/data1/AgentG/hhb/digitalhuman/ScriptAgent/code
SCRIPTAGENT_PYTHON=/data1/AgentG/anaconda3/envs/loraLLM/bin/python
SCRIPTAGENT_ENABLE_OMNI_COMPAT=1
SCRIPTAGENT_MODELSCOPE_CACHE=/tmp/modelscope_cache
SCRIPTAGENT_HF_HOME=/tmp/hf_cache
SCRIPTAGENT_HF_HUB_CACHE=/tmp/hf_cache/hub
SCRIPTAGENT_TRANSFORMERS_CACHE=/tmp/hf_cache/transformers

# DirectorAgent credentials (Distill platform)
SCRIPTAGENT_APP_ID=
SCRIPTAGENT_APP_KEY=

# CriticAgent (Gemini backend via DistillInterface)
SCRIPTAGENT_CRITIC_USER_ID=
SCRIPTAGENT_CRITIC_API_KEY=
SCRIPTAGENT_CRITIC_MODEL=gemini-2.5-pro
SCRIPTAGENT_VIDEO_BACKEND=gemini
